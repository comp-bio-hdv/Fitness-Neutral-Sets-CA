Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"maxLifetime", "=", "200"}], ",", "originalRule", ",", 
     "mutatedRule", ",", "originalLifetime", ",", "mutatedLifetime", ",", 
     "data", ",", 
     RowBox[{"k", "=", "3"}], ",", 
     RowBox[{"lifetimeCounter", "=", 
      RowBox[{"<|", "|>"}]}], ",", "ruleSerialNumber", ",", 
     "progressIndicator", ",", " ", "ruleMutations", ",", 
     "mutationsAttemptsPerRule", ",", "mutationSet", ",", " ", 
     RowBox[{"successfulChains", "=", "0"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "a", " ", "dialog", " ", "to", " ", "prompt", " ", "the", " ",
      "user", " ", "for", " ", "input", " ", "and", " ", "validate", " ", 
     "input", " ", "to", " ", "be", " ", "positive", " ", "integers"}], 
    "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "targetLifetime", ",", "maxMutationsAttemptsPerRule", ",", 
       "ruleBucketSize", ",", "debugFlag"}], "}"}], "=", 
     RowBox[{"DialogInput", "[", 
      RowBox[{"DynamicModule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"targetLifetime", "=", "20"}], ",", 
          RowBox[{"maxMutationsAttemptsPerRule", "=", "500"}], ",", 
          RowBox[{"ruleBucketSize", "=", "10"}], ",", 
          RowBox[{"debugFlag", "=", "False"}]}], "}"}], ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Configuration (enter positive integers)\>\"", ",", 
             RowBox[{"FontSize", "->", "18"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Target Lifetime \>\"", ",", 
              RowBox[{"InputField", "[", 
               RowBox[{
                RowBox[{"Dynamic", "[", "targetLifetime", "]"}], ",", 
                "Number", ",", 
                RowBox[{"FieldSize", "->", "Tiny"}]}], "]"}]}], "}"}], "]"}], 
           ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Number Of Mutation Chains \>\"", ",", 
              RowBox[{"InputField", "[", 
               RowBox[{
                RowBox[{"Dynamic", "[", "ruleBucketSize", "]"}], ",", 
                "Number", ",", 
                RowBox[{"FieldSize", "->", "Tiny"}]}], "]"}]}], "}"}], "]"}], 
           ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Max Mutation Attempts Per Chain \>\"", ",", 
              RowBox[{"InputField", "[", 
               RowBox[{
                RowBox[{"Dynamic", "[", "maxMutationsAttemptsPerRule", "]"}], 
                ",", "Number", ",", 
                RowBox[{"FieldSize", "->", "Tiny"}]}], "]"}]}], "}"}], "]"}], 
           ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Debug Flag \>\"", ",", 
              RowBox[{"PopupMenu", "[", 
               RowBox[{
                RowBox[{"Dynamic", "[", "debugFlag", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"True", ",", "False"}], "}"}]}], "]"}]}], "}"}], 
            "]"}], ",", 
           RowBox[{"DefaultButton", "[", 
            RowBox[{"\"\<OK\>\"", ",", 
             RowBox[{"DialogReturn", "[", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"And", "@@", 
                  RowBox[{"(", 
                   RowBox[{"IntegerQ", "/@", 
                    RowBox[{"{", 
                    RowBox[{
                    "targetLifetime", ",", "maxMutationsAttemptsPerRule", ",",
                     "ruleBucketSize"}], "}"}]}], ")"}]}], "&&", 
                 RowBox[{"And", "@@", 
                  RowBox[{"(", 
                   RowBox[{"Positive", "/@", 
                    RowBox[{"{", 
                    RowBox[{
                    "targetLifetime", ",", "maxMutationsAttemptsPerRule", ",",
                     "ruleBucketSize"}], "}"}]}], ")"}]}]}], ",", 
                RowBox[{"{", 
                 RowBox[{
                 "targetLifetime", ",", "maxMutationsAttemptsPerRule", ",", 
                  "ruleBucketSize", ",", "debugFlag"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"Null", ",", "Null", ",", "Null", ",", "Null"}], 
                 "}"}]}], " ", 
               RowBox[{"(*", 
                RowBox[{
                "Return", " ", "a", " ", "list", " ", "of", " ", "Nulls", " ",
                  "instead", " ", "of", " ", 
                 RowBox[{"DialogReturn", "[", 
                  RowBox[{"{", "}"}], "]"}]}], "*)"}], "]"}], "]"}]}], 
            "]"}]}], "}"}], "]"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{"Check", " ", "if", " ", "inputs", " ", "are", " ", "valid"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "targetLifetime", ",", "maxMutationsAttemptsPerRule", ",", 
          "ruleBucketSize"}], "}"}], ",", "Null"}], "]"}], ",", 
      RowBox[{
      "Return", 
       "[", "\"\<Invalid input. Please enter positive integers for all \
fields.\>\"", "]"}]}], "]"}], ";", "\n", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Call", " ", "searchForUnfitRules", " ", "and", " ", "store", " ", "the",
       " ", "result", " ", "in", " ", "RuleBucket", " ", "which", " ", 
      "contains", " ", "a", " ", "list", " ", "of", " ", "rules", " ", "with",
       " ", "a", " ", "lifetime", " ", "of", " ", "1"}], " ", "*)"}], "    ", 
    RowBox[{"RuleBucket", "=", 
     RowBox[{"searchForUnfitRules", "[", "ruleBucketSize", "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Initialize", " ", "the", " ", "progress", " ", "indicator"}], 
     "*)"}], "\[IndentingNewLine]", " ", 
    RowBox[{"ruleSerialNumber", "=", "0"}], ";", "\[IndentingNewLine]", " ", 
    RowBox[{"progressIndicator", "=", 
     RowBox[{"ProgressIndicator", "[", 
      RowBox[{
       RowBox[{"Dynamic", "[", 
        RowBox[{"ruleSerialNumber", "/", "ruleBucketSize"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
     " ", 
    RowBox[{"Print", "[", "progressIndicator", "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Iterate", " ", "over", " ", "each", " ", "rule", " ", "in", " ", 
      "RuleBucket"}], " ", "*)"}], "\[IndentingNewLine]", "  ", 
    RowBox[{
    "Do", "[", "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ruleSerialNumber", "++"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Update", " ", "progress", " ", "indicator"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Pause", "[", "0.1", "]"}], ";", "\[IndentingNewLine]", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Print", " ", "summary", " ", "of", " ", "run", " ", "when", " ", 
         "it", " ", "is", " ", "done"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ruleSerialNumber", "==", "ruleBucketSize"}], ",", 
         "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"Print", "[", "\[IndentingNewLine]", "\t\t", 
           RowBox[{"Grid", "[", "\[IndentingNewLine]", "\t\t\t", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", "\t\t\t\t", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<Summary\>\"", ",", "\"\<\>\""}], "}"}], ",", 
               "\[IndentingNewLine]", "\t\t\t\t", 
               RowBox[{"{", 
                RowBox[{"\"\<Target Lifetime\>\"", ",", "targetLifetime"}], 
                "}"}], ",", "\[IndentingNewLine]", "\t\t\t\t", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Number Of Mutation Chains\>\"", ",", 
                 "ruleBucketSize"}], "}"}], ",", "\[IndentingNewLine]", 
               "\t\t\t\t", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Number Of Successful Mutation Chains\>\"", ",", 
                 "successfulChains"}], "}"}], ",", "\[IndentingNewLine]", 
               "\t\t\t\t", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Max Mutation Attempts Per Chain\>\"", ",", 
                 "maxMutationsAttemptsPerRule"}], "}"}], ",", 
               "\[IndentingNewLine]", "\t\t\t\t", 
               RowBox[{"{", 
                RowBox[{"\"\<Debug Flag\>\"", ",", "debugFlag"}], "}"}]}], 
              "\[IndentingNewLine]", "\t\t\t", "}"}], ",", 
             "\[IndentingNewLine]", "\t\t\t", 
             RowBox[{"Frame", "->", "All"}], ",", "\[IndentingNewLine]", 
             "\t\t\t", 
             RowBox[{"Background", "->", 
              RowBox[{"{", 
               RowBox[{"None", ",", 
                RowBox[{"{", 
                 RowBox[{"LightGray", ",", 
                  RowBox[{"{", "White", "}"}]}], "}"}]}], "}"}]}], ",", 
             "\[IndentingNewLine]", "\t\t\t", 
             RowBox[{"ItemStyle", "->", 
              RowBox[{"Directive", "[", 
               RowBox[{"Bold", ",", 
                RowBox[{"FontColor", "->", 
                 RowBox[{"Darker", "[", "Red", "]"}]}]}], "]"}]}], ",", 
             "\[IndentingNewLine]", "\t\t\t", 
             RowBox[{"Spacings", "->", 
              RowBox[{"{", 
               RowBox[{"2", ",", "2"}], "}"}]}], ",", "\[IndentingNewLine]", 
             "\t\t\t", 
             RowBox[{"Alignment", "->", "Center"}]}], "\[IndentingNewLine]", 
            "\t\t", "]"}], "\[IndentingNewLine]", "\t", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"mutationsAttemptsPerRule", "=", "0"}], ";", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"lifetimeCounter", "=", 
        RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "    ", 
       RowBox[{"originalRule", "=", "rule"}], ";", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"originalLifetime", "=", "1"}], ";", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{
        RowBox[{"lifetimeCounter", "[", "originalLifetime", "]"}], "=", "1"}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "    ", 
       RowBox[{"(*", " ", 
        RowBox[{"Continuously", " ", "attempt", " ", "mutations"}], " ", 
        "*)"}], "\[IndentingNewLine]", "    ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
         "mutationsAttemptsPerRule", "<", "maxMutationsAttemptsPerRule"}], ",",
          "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"mutationSet", "=", 
           RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "      ", 
          RowBox[{"ruleMutations", "=", "0"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{"ruleMutations", "<", "52"}], ",", " ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "a", " ", "max", " ", "of", " ", "52", " ", "point", " ", 
              "mutations", " ", "per", " ", "rule"}], " ", "*)"}], 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "Attempt", " ", "a", " ", "new", " ", "point", " ", "mutation"}],
              " ", "*)"}], "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"mutatedRule", "=", 
              RowBox[{"RandomRuleMutation", "[", 
               RowBox[{"{", 
                RowBox[{"originalRule", ",", "k", ",", "1"}], "}"}], "]"}]}], 
             ";", "\[IndentingNewLine]", "        ", 
             RowBox[{"mutationsAttemptsPerRule", "++"}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", "        ", 
             RowBox[{"(*", " ", 
              RowBox[{"Avoid", " ", "repeating", " ", "mutations"}], " ", 
              "*)"}], "\[IndentingNewLine]", "        ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"KeyExistsQ", "[", 
                 RowBox[{"mutationSet", ",", "mutatedRule"}], "]"}]}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{
                RowBox[{
                 RowBox[{"mutationSet", "[", "mutatedRule", "]"}], "=", 
                 "True"}], ";", "\[IndentingNewLine]", "          ", 
                RowBox[{"ruleMutations", "++"}], ";", "\[IndentingNewLine]", 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"(*", " ", 
                 RowBox[{
                 "Test", " ", "the", " ", "lifetime", " ", "of", " ", "the", " ",
                   "mutated", " ", "rule"}], " ", "*)"}], 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"mutatedLifetime", "=", 
                 RowBox[{"TestLifetime", "[", 
                  RowBox[{"mutatedRule", ",", "maxLifetime"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", "          ", 
                RowBox[{"(*", "\n", "          ", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"\"\<Rule: \>\"", ",", 
                    RowBox[{"First", "[", "mutatedRule", "]"}], 
                    ",", "\"\< ruleMutations: \>\"", ",", "ruleMutations", 
                    ",", "\"\< totMutations: \>\"", ",", " ", 
                    "mutationsAttemptsPerRule", ",", "\"\< Lifetime: \>\"", ",",
                     "mutatedLifetime"}], "]"}], ";"}], "\n", "          ", 
                 "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
                "          ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                  "mutationsAttemptsPerRule", "==", 
                   "maxMutationsAttemptsPerRule"}], ",", 
                  "\[IndentingNewLine]", "            ", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"debugFlag", "==", "True"}], ",", 
                    "\[IndentingNewLine]", "              ", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"\<REACHED MAXIMUM MUTATIONS PER RULE! Last \
Rule Number: \>\"", ",", "originalRule", ",", "\"\< Last Lifetime: \>\"", ",",
                     "originalLifetime"}], " ", "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "            ", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "          ", "]"}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", "          ", 
                RowBox[{"(*", " ", 
                 RowBox[{
                  RowBox[{"Check", " ", "if", " ", "the", " ", "mutated", " ", 
                   RowBox[{"rule", "'"}], "s", " ", "lifetime", " ", "is", " ",
                    "equal", " ", "to", " ", "or", " ", "greater", " ", 
                   "than", " ", "the", " ", "current", " ", "lifetime"}], ",",
                   " ", 
                  RowBox[{
                  "if", " ", "so", " ", "then", " ", "accept", " ", 
                   "mutation"}]}], "*)"}], "\[IndentingNewLine]", 
                "          ", 
                RowBox[{"If", "[", "\[IndentingNewLine]", "            ", 
                 RowBox[{
                  RowBox[{"mutatedLifetime", ">=", "originalLifetime"}], ",", 
                  "\[IndentingNewLine]", "            ", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "Update", " ", "the", " ", "rule", " ", "and", " ", "its", 
                    " ", "lifetime"}], " ", "*)"}], "\[IndentingNewLine]", 
                  "            ", 
                  RowBox[{
                   RowBox[{"originalRule", "=", 
                    RowBox[{"First", "[", "mutatedRule", "]"}]}], ";", 
                   "\[IndentingNewLine]", "            ", 
                   RowBox[{"originalLifetime", "=", "mutatedLifetime"}], ";", 
                   "\[IndentingNewLine]", "\[IndentingNewLine]", 
                   "            ", 
                   RowBox[{"(*", " ", 
                    RowBox[{
                    "Update", " ", "the", " ", "counter", " ", "for", " ", 
                    "the", " ", "new", " ", "lifetime"}], " ", "*)"}], 
                   "\[IndentingNewLine]", "            ", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"KeyExistsQ", "[", 
                    RowBox[{"lifetimeCounter", ",", "originalLifetime"}], 
                    "]"}], ",", "\[IndentingNewLine]", "              ", 
                    RowBox[{
                    RowBox[{"lifetimeCounter", "[", "originalLifetime", "]"}],
                     "++"}], ",", "\[IndentingNewLine]", "              ", 
                    RowBox[{
                    RowBox[{"lifetimeCounter", "[", "originalLifetime", "]"}],
                     "=", "1"}]}], "\[IndentingNewLine]", "            ", 
                    "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                   "            ", 
                   RowBox[{"(*", " ", 
                    RowBox[{
                    "Break", " ", "to", " ", "check", " ", "lifetime", " ", 
                    "reached", " ", "and", " ", "start", " ", "mutating", " ",
                     "the", " ", "accepted", " ", "rule", " ", "again", " ", 
                    "if", " ", "necessary"}], " ", "*)"}], 
                   "\[IndentingNewLine]", "            ", 
                   RowBox[{"Break", "[", "]"}]}]}], "\[IndentingNewLine]", 
                 "          ", "]"}], ";"}]}], "\[IndentingNewLine]", 
              "        ", "]"}]}]}], "\[IndentingNewLine]", "      ", "]"}], ";",
           "\[IndentingNewLine]", "\[IndentingNewLine]", "      ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
