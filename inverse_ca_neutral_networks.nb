 RowBox[{
  RowBox[{"ClearAll", "[", "searchForUnfitRules", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"searchForUnfitRules", "[", 
   RowBox[{
    RowBox[{"sampleSize_", " ", ":", " ", "1000"}], ",", 
    RowBox[{"k_", " ", ":", " ", "3"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  "    ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rules", ",", "fixedPositions"}], "}"}], ",", 
    "\[IndentingNewLine]", "      ", 
    RowBox[{
     RowBox[{"fixedPositions", "=", 
      RowBox[{"{", 
       RowBox[{"27", ",", "26", ",", "24", ",", "18"}], "}"}]}], ";", 
     "\[IndentingNewLine]", "      ", "\[IndentingNewLine]", "      ", 
     RowBox[{"rules", "=", 
      RowBox[{"Sort", "[", "\[IndentingNewLine]", "        ", 
       RowBox[{"DeleteDuplicates", "[", "\[IndentingNewLine]", "          ", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "            ", 
         RowBox[{
          RowBox[{"FromDigits", "[", "\[IndentingNewLine]", "              ", 
           RowBox[{
            RowBox[{"ReplacePart", "[", 
             RowBox[{
              RowBox[{"RandomInteger", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"k", "-", "1"}]}], "}"}], ",", "27"}], "]"}], ",", 
              "\[IndentingNewLine]", "                ", 
              RowBox[{"Thread", "[", 
               RowBox[{"fixedPositions", "->", "0"}], "]"}]}], "]"}], ",", 
            "k"}], "\[IndentingNewLine]", "            ", "]"}], ",", 
          "\[IndentingNewLine]", "            ", 
          RowBox[{"{", "sampleSize", "}"}]}], "\[IndentingNewLine]", 
         "          ", "]"}], "\[IndentingNewLine]", "        ", "]"}], 
       "\[IndentingNewLine]", "      ", "]"}]}], ";", "\[IndentingNewLine]", 
     "      ", "\[IndentingNewLine]", "    ", 
     RowBox[{"Return", "[", "rules", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "    ", "]"}]}]}], "Input",
