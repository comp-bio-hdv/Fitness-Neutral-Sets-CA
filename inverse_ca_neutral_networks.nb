Cell[TextData[StyleBox["searchForUnfitRules simply creates a random set of \
rules which are constraint to a lifetime of 1 which are the ones we want to \
start the point mutations chains from - this is ensured when the four \
relevant neighbourhoods for the fixed initial condition transform to zero by \
the rule, hence we are fixing {0, 0, 0}\[RightArrow]0, {0, 0, \
1}\[RightArrow]0, {0, 1, 0}\[RightArrow]0 and {1, 0, 0}\[RightArrow]0 (for \
which the least significant ternary bits are {27,26,24,18})",
 FontFamily->"Constantia",
 FontSize->16,
 FontWeight->"Normal",
 FontColor->RGBColor[0.5019607843137255, 0., 0.]]], "Text",
 CellChangeTimes->{{3.956830971381712*^9, 3.9568310037439976`*^9}, {
