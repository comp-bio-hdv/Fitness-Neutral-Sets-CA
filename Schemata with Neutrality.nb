Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "lifetime", " ", "of", " ", "a", " ", "rule", " ", "given",
     " ", "initial", " ", "state"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"TestLifetime", "[", 
     RowBox[{"rule_Integer", ",", 
      RowBox[{"init_List", ":", 
       RowBox[{"{", "1", "}"}]}], ",", 
      RowBox[{"max_Integer", ":", "100"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "array", "}"}], ",", 
      RowBox[{
       RowBox[{"array", "=", 
        RowBox[{"CellularAutomaton", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rule", ",", "2", ",", "2"}], "}"}], ",", "init", ",", 
          RowBox[{"{", 
           RowBox[{"max", ",", "All"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", "==", "0"}], ",", 
           RowBox[{"-", "Infinity"}], ",", 
           RowBox[{"max", "-", "#", "+", "1"}]}], "]"}], "&"}], "[", 
        RowBox[{"LengthWhile", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "array", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}], 
        "]"}]}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"RandomRuleMutation", "[", 
     RowBox[{"rule_Integer", ",", 
      RowBox[{"many_Integer", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ruleList", ",", "mutatedList", ",", "positions"}], "}"}], ",", 
      RowBox[{
       RowBox[{"ruleList", "=", 
        RowBox[{"ruleNumberToList", "[", "rule", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"positions", "=", 
        RowBox[{"RandomSample", "[", 
         RowBox[{
          RowBox[{"1", ";;", 
           RowBox[{"Length", "[", "ruleList", "]"}]}], ",", "many"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"mutatedList", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"ruleList", ",", 
          RowBox[{"Thread", "[", 
           RowBox[{"positions", "->", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ruleList", "[", 
                RowBox[{"[", "positions", "]"}], "]"}], "+", "1"}], ",", 
              "2"}], "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"FromDigits", "[", 
        RowBox[{"mutatedList", ",", "2"}], "]"}]}]}], "  ", 
     RowBox[{"(*", 
      RowBox[{
      "return", " ", "mutated", " ", "rule", " ", "as", " ", "integer"}], 
      "*)"}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CustomStyleData", "[", "key_", "]"}], ":=", 
    RowBox[{"Lookup", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<Colors\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "->", "White"}], ",", 
           RowBox[{"1", "->", "Black"}]}], "}"}]}], ",", 
        RowBox[{"\"\<HighlightColors\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "->", "White"}], ",", 
           RowBox[{"1", "->", 
            RowBox[{"Lighter", "[", 
             RowBox[{"Black", ",", "0.8"}], "]"}]}]}], "}"}]}], ",", 
        RowBox[{"\"\<ListPlot\>\"", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.368417", ",", "0.506779", ",", "0.709798"}], "]"}], ",", 
           RowBox[{"EdgeStyle", "[", 
            RowBox[{"Opacity", "[", "0.25", "]"}], "]"}]}], "]"}]}]}], "]"}], 
      ",", 
      RowBox[{"Key", "[", "key", "]"}]}], "]"}]}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.956830971381712*^9, 3.9568310037439976`*^9}, {
