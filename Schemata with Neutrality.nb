Cell[TextData[StyleBox["Point mutation chains are run using  WL  functions \
RandomRuleMutation and TestLifetime",
 FontFamily->"Constantia",
 FontSize->16,
 FontWeight->"Normal",
 FontColor->RGBColor[0.5019607843137255, 0., 0.]]], "Text",
 CellChangeTimes->{{3.956830971381712*^9, 3.9568310037439976`*^9}, {
