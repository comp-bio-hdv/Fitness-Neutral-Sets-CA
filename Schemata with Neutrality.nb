Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "DEFINITIONS", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ruleNumberToList", "[", "rule_Integer", "]"}], ":=", 
    RowBox[{"IntegerDigits", "[", 
     RowBox[{"rule", ",", "2", ",", "32"}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TestLifetime", "[", 
     RowBox[{"rule_Integer", ",", 
      RowBox[{"init_List", ":", 
       RowBox[{"{", "1", "}"}]}], ",", 
      RowBox[{"max_Integer", ":", "100"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "array", "}"}], ",", 
      RowBox[{
       RowBox[{"array", "=", 
        RowBox[{"CellularAutomaton", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rule", ",", "2", ",", "2"}], "}"}], ",", "init", ",", 
          RowBox[{"{", 
           RowBox[{"max", ",", "All"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", "==", "0"}], ",", 
           RowBox[{"-", "Infinity"}], ",", 
           RowBox[{"max", "-", "#", "+", "1"}]}], "]"}], "&"}], "[", 
        RowBox[{"LengthWhile", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "array", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}], 
        "]"}]}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RandomRuleMutation", "[", 
     RowBox[{"rule_Integer", ",", 
      RowBox[{"many_Integer", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ruleList", ",", "mutatedList", ",", "positions", ",", "n"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"ruleList", "=", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"rule", ",", "2", ",", "32"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"many", ",", "32"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"positions", "=", 
        RowBox[{"RandomSample", "[", 
         RowBox[{
          RowBox[{"Range", "[", "32", "]"}], ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mutatedList", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"ruleList", ",", 
          RowBox[{"Thread", "[", 
           RowBox[{"positions", "->", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ruleList", "[", 
                RowBox[{"[", "positions", "]"}], "]"}], "+", "1"}], ",", 
              "2"}], "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"FromDigits", "[", 
        RowBox[{"mutatedList", ",", "2"}], "]"}]}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"searchForUnfitRules", "[", 
     RowBox[{"sampleSize_", ":", "5"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rules", ",", "r"}], "}"}], ",", 
      RowBox[{
       RowBox[{"rules", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "rules", "]"}], "<", "sampleSize"}], ",", 
         RowBox[{
          RowBox[{"r", "=", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{
               RowBox[{"2", "^", "32"}], "-", "1"}]}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"TestLifetime", "[", 
              RowBox[{"r", ",", 
               RowBox[{"{", "1", "}"}], ",", "20"}], "]"}], "==", "1"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", "r"}], "]"}]}], "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "rules"}]}], "]"}]}]}]}]], "Input",
