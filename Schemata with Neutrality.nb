Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"MAIN", " ", "CODE"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"k", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"steps", "=", "35"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"width", "=", "101"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetLifetime", "=", "26"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxRestarts", "=", "150"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mutationsPerRestart", "=", "2000"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "init", ",", "currentRule", ",", "currentLifetime", ",", "currentDist", 
       ",", "found", ",", "candidate", ",", "candidateLifetime", ",", 
       "candidateDist", ",", "bestRule", ",", "bestLifetime", ",", "bestDist",
        ",", "unfitPool", ",", "verifiedLifetime", ",", "restartCount", ",", 
       "ruleNumber", ",", "lookupTable", ",", "neighborhoods", ",", 
       "lookupVisual", ",", "caData", ",", "phenotypeVisual"}], "}"}], ",", 
     RowBox[{
      RowBox[{"init", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "width"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"init", "[", 
        RowBox[{"[", 
         RowBox[{"Ceiling", "[", 
          RowBox[{"width", "/", "2"}], "]"}], "]"}], "]"}], "=", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"found", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"bestDist", "=", "Infinity"}], ";", "\[IndentingNewLine]", 
      RowBox[{"restartCount", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<=== SEARCH LOG ===\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Target lifetime: \>\"", ",", "targetLifetime"}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<Every restart begins from lifetime 1 (via \
searchForUnfitRules)\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"found", ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"restartCount", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"unfitPool", "=", 
          RowBox[{"searchForUnfitRules", "[", "1", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"currentRule", "=", 
          RowBox[{"unfitPool", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"verifiedLifetime", "=", 
          RowBox[{"TestLifetime", "[", 
           RowBox[{"currentRule", ",", "init", ",", "steps"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Restart \>\"", ",", "restartCount", 
           ",", "\"\< | Starting rule: \>\"", ",", "currentRule", 
           ",", "\"\< | Starting lifetime: \>\"", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"verifiedLifetime", "==", 
              RowBox[{"-", "Infinity"}]}], ",", "1", ",", 
             "verifiedLifetime"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"currentLifetime", "=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"currentDist", "=", 
          RowBox[{"Abs", "[", 
           RowBox[{"1", "-", "targetLifetime"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"found", ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"candidate", "=", 
             RowBox[{"RandomRuleMutation", "[", 
              RowBox[{"currentRule", ",", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "3"}], "}"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"candidateLifetime", "=", 
             RowBox[{"TestLifetime", "[", 
              RowBox[{"candidate", ",", "init", ",", "steps"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"candidateDist", "=", 
             RowBox[{"Abs", "[", 
              RowBox[{"candidateLifetime", "-", "targetLifetime"}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"candidateDist", "<=", "currentDist"}], ",", 
              RowBox[{
               RowBox[{"currentRule", "=", "candidate"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"currentLifetime", "=", "candidateLifetime"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"currentDist", "=", "candidateDist"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"currentDist", "==", "0"}], ",", 
                 RowBox[{
                  RowBox[{"found", "=", "True"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"bestRule", "=", "currentRule"}], ";", 
                  RowBox[{"bestLifetime", "=", "currentLifetime"}], ";", 
                  RowBox[{"bestDist", "=", "0"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Print", "[", 
                   
                   RowBox[{"\"\<  >>> FOUND at restart \>\"", ",", 
                    "restartCount", ",", "\"\< | Rule: \>\"", ",", 
                    "currentRule", ",", "\"\< | Lifetime: \>\"", ",", 
                    "currentLifetime"}], "]"}]}]}], "]"}]}]}], "]"}]}], ",", 
           RowBox[{"{", "mutationsPerRestart", "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", "found"}], ",", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<  End of restart \>\"", ",", "restartCount", 
             ",", "\"\< | Climbed to lifetime \>\"", ",", "currentLifetime", 
             ",", "\"\< (distance \>\"", ",", "currentDist", 
             ",", "\"\<)\>\""}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", "found"}], "&&", 
            RowBox[{"currentDist", "<", "bestDist"}]}], ",", 
           RowBox[{
            RowBox[{"bestRule", "=", "currentRule"}], ";", 
            RowBox[{"bestLifetime", "=", "currentLifetime"}], ";", 
            RowBox[{"bestDist", "=", "currentDist"}]}]}], "]"}]}], ",", 
        RowBox[{"{", "maxRestarts", "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<=== SEARCH COMPLETE ===\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", "found"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Did not converge. Closest lifetime: \>\"", ",", 
          "bestLifetime", ",", "\"\< (distance \>\"", ",", "bestDist", 
          ",", "\"\<).\>\""}], "]"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Found rule \>\"", ",", "bestRule", 
           ",", "\"\< with lifetime \>\"", ",", "bestLifetime"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"ruleNumber", "=", "bestRule"}], ";", "\[IndentingNewLine]", 
         RowBox[{"lookupTable", "=", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"ruleNumber", ",", "2", ",", "32"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"neighborhoods", "=", 
          RowBox[{"Reverse", "[", 
           RowBox[{"Tuples", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{
              RowBox[{"2", " ", "r"}], "+", "1"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"lookupVisual", "=", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ArrayPlot", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"neighborhoods", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "}"}], ",", 
                  RowBox[{"ColorRules", "->", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"0", "->", "White"}], ",", 
                    RowBox[{"1", "->", "Black"}]}], "}"}]}], ",", 
                  RowBox[{"Mesh", "->", "True"}], ",", 
                  RowBox[{"MeshStyle", "->", 
                   RowBox[{"Directive", "[", 
                    RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
                  RowBox[{"Frame", "->", "False"}], ",", 
                  RowBox[{"ImageSize", "->", "100"}]}], "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<\[RightArrow]\>\"", ",", "16"}], "]"}], ",", 
                RowBox[{"ArrayPlot", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"lookupTable", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "}"}], "}"}], ",", 
                  RowBox[{"ColorRules", "->", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"0", "->", "White"}], ",", 
                    RowBox[{"1", "->", "Black"}]}], "}"}]}], ",", 
                  RowBox[{"Mesh", "->", "True"}], ",", 
                  RowBox[{"MeshStyle", "->", 
                   RowBox[{"Directive", "[", 
                    RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
                  RowBox[{"Frame", "->", "False"}], ",", 
                  RowBox[{"ImageSize", "->", "40"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "32"}], "}"}]}], "]"}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}], ",", 
            RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"caData", "=", 
          RowBox[{"CellularAutomaton", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ruleNumber", ",", "k", ",", "r"}], "}"}], ",", "init", ",",
             "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"phenotypeVisual", "=", 
          RowBox[{"ArrayPlot", "[", 
           RowBox[{"caData", ",", 
            RowBox[{"ColorRules", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"0", "->", "White"}], ",", 
               RowBox[{"1", "->", "Black"}]}], "}"}]}], ",", 
            RowBox[{"Mesh", "->", "True"}], ",", 
            RowBox[{"MeshStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"ImageSize", "->", "400"}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Rule: \>\"", ",", "ruleNumber", 
                ",", "\"\<  |  Lifetime: \>\"", ",", "bestLifetime"}], "}"}], 
              "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Column", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                
                RowBox[{"\"\<Genotype (Lookup Table)\>\"", ",", "16", ",", 
                 "Bold"}], "]"}], ",", "lookupVisual"}], "}"}], "]"}], ",", 
            RowBox[{"Spacer", "[", "50", "]"}], ",", 
            RowBox[{"Column", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                
                RowBox[{"\"\<Phenotype (CA Evolution)\>\"", ",", "16", ",", 
                 "Bold"}], "]"}], ",", "phenotypeVisual"}], "}"}], "]"}]}], 
           "}"}], "]"}]}]}], "]"}]}]}], "]"}]}]}]], "Input",
